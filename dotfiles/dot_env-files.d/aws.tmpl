{{- if eq .config "work-laptop"}}
#!/usr/bin/env bash

# WARNING: THIS FILE IS MANAGED BY CHEZMOI

aws_sso_profiles() {
    awk '
        /^[[:space:]]*[#;]/ { next }
        /^[[:space:]]*\[/ {
            hdr = $0
            sub(/^[[:space:]]*\[[[:space:]]*/, "", hdr)
            sub(/[[:space:]]*\].*$/, "", hdr)
            printed = 0
            if (hdr == "default") {
                name = "default"
            } else if (hdr ~ /^profile[[:space:]]/) {
                sub(/^profile[[:space:]]+/, "", hdr)
                name = hdr
            } else {
                name = ""
            }
            next
        }
        name != "" && !printed && /^[[:space:]]*sso_(session|start_url)[[:space:]]*=/ {
            print name
            printed = 1
        }
    ' "${AWS_CONFIG_FILE:-${HOME}/.aws/config}"
}

awsssologin() {
    profile="${1}"
    sso_profiles=$(aws_sso_profiles)

    if [ -z "${sso_profiles}" ]; then
        printf 'no SSO profiles configured; run: aws configure sso\n' >&2
        return 1
    fi

    if [ -z "${profile}" ]; then
        if command -v gum >/dev/null 2>&1; then
            profile=$(printf '%s\n' "${sso_profiles}" | gum filter \
                --placeholder "select a profile..." \
                --height 15 --select-if-one --limit=1 \
                --indicator "" \
                --cursor-text.background 238 \
                --cursor-text.bold)
        else
            printf 'USAGE: awsssologin <profile>\n' >&2
            return 1
        fi
    fi

    [ -z "${profile}" ] && return 1

    if ! printf '%s\n' "${sso_profiles}" | grep -qxF -- "${profile}"; then
        if aws configure list-profiles 2>/dev/null | grep -qxF -- "${profile}"; then
            printf 'ERROR: profile "%s" exists but is not an SSO profile.\n' "${profile}" >&2
        else
            printf 'ERROR: profile "%s" not found in your AWS config.\n' "${profile}" >&2
        fi
        return 1
    fi

    printf 'Logging in to %s profile...\n\n' "${profile}"
    aws sso login --profile "${profile}" --no-browser || return 1

    aws sts get-caller-identity --profile "${profile}"
}
{{ end }}
