#!/usr/bin/env bash
# WARNING: This file is managed by chezmoi.
set -euo pipefail

SCRIPT_DIR=$( cd -- "$( dirname -- "${BASH_SOURCE[0]}" )" &> /dev/null && pwd )
source "${SCRIPT_DIR}/lib/logger.sh"

POSITIONAL_ARGS=()
LEVEL=20
MIN_DAYS=3

ARCH=$(uname -m)
case "$ARCH" in
    x86_64)  ARCH="amd64" ;;
    aarch64) ARCH="arm64" ;;
    *)       printf "Unsupported architecture: %s\n" "$ARCH" >&2; exit 1 ;;
esac

USAGE=$(cat <<EOF
Usage:
    $(basename "$0") <args> [binary...|all]

    Binaries:
        jq, glab, claude, yq, rtk

    Arguments:
        -d|--debug      : Print debug statements
        -h|--help       : Show this message
EOF
)

# --- per-tool config tables -------------------------------------------------

declare -A TOOL_API_URL=(
    [jq]="https://api.github.com/repos/jqlang/jq/releases"
    [glab]="https://gitlab.com/api/v4/projects/34675721/releases"
    [claude]="https://api.github.com/repos/anthropics/claude-code/releases"
    [yq]="https://api.github.com/repos/mikefarah/yq/releases"
    # per_page is raised because rtk cuts rc builds constantly — only ~3 of the
    # most recent 30 tags are stable, so the default page can hold no stable
    # release at all during an rc burst.
    [rtk]="https://api.github.com/repos/rtk-ai/rtk/releases?per_page=100"
)
declare -A TOOL_VERSION_FILTER=(
    [jq]='.tag_name'
    [glab]='.tag_name'
    [claude]='.tag_name'
    [yq]='.tag_name'
    [rtk]='.tag_name'
)
declare -A TOOL_DATE_FILTER=(
    [jq]='.published_at'
    [glab]='.released_at'
    [claude]='.published_at'
    [yq]='.published_at'
    [rtk]='.published_at'
)
declare -A TOOL_RELEASE_URL=(
    [jq]="https://github.com/jqlang/jq/releases"
    [glab]="https://gitlab.com/gitlab-org/cli/-/releases"
    [claude]="https://github.com/anthropics/claude-code/releases"
    [yq]="https://github.com/mikefarah/yq/releases"
    [rtk]="https://github.com/rtk-ai/rtk/releases"
)
# Optional per-tool jq filter applied to each release before the version/date
# projection; defaults to '.' (keep everything). rtk publishes its rc builds as
# prereleases tagged dev-0.45.0-rc.350 — version_number() reads that as 0.45.0
# and would rank it above stable v0.44.2, so those have to be dropped here.
declare -A TOOL_RELEASE_SELECT=(
    [rtk]='select(.prerelease == false)'
)

function usage() {
    printf "%s\n" "${USAGE}"
    exit 99
}

function argparse() {
    while [[ $# -gt 0 ]]; do
        case $1 in
            -d|--debug)
                LEVEL=10
                shift
                ;;
            -h|--help)
                usage
                ;;
            -*)
                log.error "Unknown option: '$1'"
                usage
                ;;
            *)
                POSITIONAL_ARGS+=("$1")
                shift
                ;;
        esac
    done
}

function validate_args() {
    local error=0
    log.debug "Validating args"

    if [[ ${#POSITIONAL_ARGS[@]} -eq 0 ]]; then
        log.error "No target specified"
        error=1
    fi

    for arg in "${POSITIONAL_ARGS[@]}"; do
        if [[ "$arg" != "all" && -z "${TOOL_API_URL[$arg]:-}" ]]; then
            log.error "Unknown target: '$arg'"
            error=1
        fi
    done

    if [[ $error -gt 0 ]]; then
        usage
        exit 1
    else
        log.info "OK"
    fi
}

# --- per-tool current-version + install -------------------------------------

function current_version_jq() {
    if command -v jq >/dev/null 2>&1; then
        jq --version
    else
        echo "null"
    fi
}

function current_version_glab() {
    if command -v glab >/dev/null 2>&1; then
        printf "v%s" "$(glab --version | awk '{print $2}')"
    else
        echo "null"
    fi
}

function current_version_claude() {
    if command -v claude >/dev/null 2>&1; then
        claude --version | awk '{printf "v%s", $1}'
    else
        echo "null"
    fi
}

function current_version_yq() {
    if command -v yq >/dev/null 2>&1; then
        yq --version | awk '{print $NF}'
    else
        echo "null"
    fi
}

function current_version_rtk() {
    if command -v rtk >/dev/null 2>&1; then
        printf "v%s" "$(rtk --version | awk '{print $2}')"
    else
        echo "null"
    fi
}

function install_jq() {
    local version="$1"
    local install_dir="$HOME/bin"
    local dest_binary="${install_dir}/jq"
    local url="https://github.com/jqlang/jq/releases/download/${version}/jq-linux-${ARCH}"

    mkdir -p "$install_dir"
    curl -s -fSL -o "${dest_binary}" "$url"
    chmod +x "${dest_binary}"
    log.info "Installed jq ${version} to ${dest_binary}"
}

function install_glab() {
    local version="$1"
    local tmp_dir="/tmp/glab-install"
    local install_dir="$HOME/bin"
    local dest_binary="${install_dir}/glab"
    local ver_novee="${version#v}"
    local enc_ver enc_tarball tarball url

    rm -rf "${tmp_dir}"
    mkdir -p "${tmp_dir}" "${install_dir}"

    enc_ver=$(printf '%s' "$ver_novee" | sed 's/\./%2E/g')
    tarball="glab_${ver_novee}_linux_${ARCH}.tar.gz"
    enc_tarball=$(printf '%s' "$tarball" | sed 's/\./%2E/g')
    url="https://gitlab.com/api/v4/projects/gitlab-org%2Fcli/packages/generic/glab/${enc_ver}/${enc_tarball}"

    log.debug "tarball: ${tarball}"
    log.debug "url: ${url//%/%%}"

    curl -s -fSL -o "${tmp_dir}/${tarball}" "$url"
    tar -xzf "${tmp_dir}/${tarball}" -C "${tmp_dir}"

    install -m 0755 "${tmp_dir}/bin/glab" "${dest_binary}"
    log.info "Installed glab ${version} to ${dest_binary}"

    rm -rf "${tmp_dir}"
}

function install_claude() {
    local version="$1"
    # The installer takes [stable|latest|VERSION] as a bare semver; without it
    # it grabs the newest release, which would bypass the ${MIN_DAYS}d gate.
    curl -fsSL https://claude.ai/install.sh | bash -s "${version#v}"
    log.info "Installed claude code ${version}"
}

function install_yq() {
    local version="$1"
    local install_dir="$HOME/bin"
    local dest_binary="${install_dir}/yq"
    local url="https://github.com/mikefarah/yq/releases/download/${version}/yq_linux_${ARCH}"

    log.debug "${url}"

    mkdir -p "$install_dir"
    curl -s -fSL -o "${dest_binary}" "$url"
    chmod +x "${dest_binary}"
    log.info "Installed yq ${version} to ${dest_binary}"
}

function install_rtk() {
    local version="$1"
    local tmp_dir="/tmp/rtk-install"
    local install_dir="$HOME/bin"
    local dest_binary="${install_dir}/rtk"
    local target tarball url

    # Assets are named by rust target triple, and the linux libc flavor is not
    # consistent across arches: x86_64 ships musl, aarch64 ships gnu.
    case "$ARCH" in
        amd64) target="x86_64-unknown-linux-musl" ;;
        arm64) target="aarch64-unknown-linux-gnu" ;;
        *)     log.error "No rtk release asset for ${ARCH}"; return 1 ;;
    esac

    rm -rf "${tmp_dir}"
    mkdir -p "${tmp_dir}" "${install_dir}"

    # The asset name carries no version — the tag in the path selects it.
    tarball="rtk-${target}.tar.gz"
    url="https://github.com/rtk-ai/rtk/releases/download/${version}/${tarball}"

    log.debug "tarball: ${tarball}"
    log.debug "url: ${url}"

    curl -s -fSL -o "${tmp_dir}/${tarball}" "$url"
    tar -xzf "${tmp_dir}/${tarball}" -C "${tmp_dir}"

    install -m 0755 "${tmp_dir}/rtk" "${dest_binary}"
    log.info "Installed rtk ${version} to ${dest_binary}"

    rm -rf "${tmp_dir}"
}

# --- generic update engine ---------------------------------------------------

function fetch_releases() {
    local tool="$1"
    local select_filter="${TOOL_RELEASE_SELECT[$tool]:-.}"
    curl -s -H "Accept: application/json" "${TOOL_API_URL[$tool]}" \
        | jq -r ".[] | ${select_filter} | [${TOOL_VERSION_FILTER[$tool]}, ${TOOL_DATE_FILTER[$tool]}] | @tsv"
}

# Strip any tag prefix so versions compare numerically: v1.112.0 -> 1.112.0,
# jq-1.8.1 -> 1.8.1. Prints nothing for unversioned input (e.g. "null").
function version_number() {
    local version="$1"
    if [[ "${version}" =~ ([0-9]+(\.[0-9]+)*) ]]; then
        printf '%s' "${BASH_REMATCH[1]}"
    fi
    return 0
}

# True when $1 is a strictly higher version than $2.
function version_gt() {
    local left right
    left=$(version_number "$1")
    right=$(version_number "$2")

    [[ -n "${left}" && -n "${right}" ]] || return 1
    [[ "${left}" == "${right}" ]] && return 1
    [[ "$(printf '%s\n%s\n' "${left}" "${right}" | sort -V | tail -n1)" == "${left}" ]]
}

function update_tool() {
    local tool="$1"
    local current_version version release_date release_epoch
    local age_seconds age_days now_epoch threshold
    local latest_version="" latest_age_days=""
    local candidate_version="" candidate_age_days=""

    current_version=$("current_version_${tool}")
    log.info "Checking for ${tool} update from ${current_version}..."

    now_epoch=$(date +%s)
    threshold=$((MIN_DAYS * 86400))

    # Walk every published release — not just the newest — so a release that is
    # held back for being under the age threshold does not hide an older,
    # already-seasoned release that we still want.
    while IFS=$'\t' read -r version release_date; do
        [[ -z "${version}" || -z "${release_date}" || "${release_date}" == "null" ]] && continue

        if ! release_epoch=$(date -d "${release_date}" +%s 2>/dev/null); then
            log.debug "${tool} ${version}: unparseable release date '${release_date}'; skipping"
            continue
        fi

        age_seconds=$((now_epoch - release_epoch))
        age_days=$((age_seconds / 86400))

        if [[ -z "${latest_version}" ]] || version_gt "${version}" "${latest_version}"; then
            latest_version="${version}"
            latest_age_days="${age_days}"
        fi

        if [[ "${age_seconds}" -le "${threshold}" ]]; then
            log.debug "${tool} ${version} is ${age_days}d old (inside ${MIN_DAYS}d threshold); skipping"
            continue
        fi

        if [[ -z "${candidate_version}" ]] || version_gt "${version}" "${candidate_version}"; then
            candidate_version="${version}"
            candidate_age_days="${age_days}"
        fi
    done < <(fetch_releases "$tool")

    if [[ -z "${latest_version}" ]]; then
        log.error "No releases found for ${tool}"
        log.info "${TOOL_RELEASE_URL[$tool]}"
        return
    fi

    log.debug "${tool} latest: '${latest_version}' (${latest_age_days}d old); eligible: '${candidate_version:-none}' (${candidate_age_days:-n/a}d old)"

    if [[ "${current_version}" == "${latest_version}" ]]; then
        log.info "${tool} already latest: ${latest_version}"
        log.info "${TOOL_RELEASE_URL[$tool]}"
        return
    fi

    if [[ "${candidate_version}" != "${latest_version}" ]]; then
        log.info "${latest_version} is ${latest_age_days}d old (newer than ${MIN_DAYS}d threshold); holding"
    fi

    if [[ -z "${candidate_version}" ]]; then
        log.info "no ${tool} release is older than ${MIN_DAYS}d yet; waiting"
        log.info "${TOOL_RELEASE_URL[$tool]}"
        return
    fi

    if [[ "${candidate_version}" == "${current_version}" ]]; then
        log.info "${tool} already at newest eligible release: ${current_version}"
        log.info "${TOOL_RELEASE_URL[$tool]}"
        return
    fi

    if [[ -n "$(version_number "${current_version}")" ]] \
        && ! version_gt "${candidate_version}" "${current_version}"; then
        log.info "${tool} ${current_version} is newer than eligible release ${candidate_version}; nothing to do"
        log.info "${TOOL_RELEASE_URL[$tool]}"
        return
    fi

    log.info "installing ${tool} ${candidate_version} (${candidate_age_days}d old)"
    "install_${tool}" "${candidate_version}"
    log.info "${tool} ${current_version} -> ${candidate_version}"
    log.info "${TOOL_RELEASE_URL[$tool]}"
}

function main() {
    argparse "$@"
    validate_args

    local targets=("${POSITIONAL_ARGS[@]}")

    if [[ " ${targets[*]} " =~ [[:space:]]all[[:space:]] ]]; then
        targets=("${!TOOL_API_URL[@]}")
    fi

    for tool in "${targets[@]}"; do
        log.info "#############################################"
        update_tool "$tool"
    done
}

main "$@"
